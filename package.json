{
  "name": "expelled",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "map:build": "node scripts/convert-tmx-to-phaser-json.mjs",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MOHG-Enterprises/Expelled.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MOHG-Enterprises/Expelled/issues"
  },
  "homepage": "https://github.com/MOHG-Enterprises/Expelled#readme",
  "dependencies": {
    "express": "^5.2.1",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "concurrently": "^9.2.1",
    "fast-xml-parser": "^5.5.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
