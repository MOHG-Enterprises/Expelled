{
  "name": "expelled",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "map:build": "node scripts/convert-tmx-to-phaser-json.mjs",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "node scripts/convert-tmx-to-phaser-json.mjs && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MOHG-Enterprises/Expelled.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MOHG-Enterprises/Expelled/issues"
  },
  "homepage": "https://github.com/MOHG-Enterprises/Expelled#readme",
  "dependencies": {
    "@types/socket.io": "^3.0.1",
    "@types/socket.io-client": "^1.4.36",
    "axios": "^1.17.0",
    "express": "^5.2.1",
    "mediasoup": "^3.19.22",
    "mediasoup-client": "^3.20.0",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/google.accounts": "^0.0.18",
    "@types/node": "^25.4.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^9.2.1",
    "fast-xml-parser": "^5.5.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.12"
  }
}
